; Sort keys are evaluated inside the report's scope, so report-level
; functions such as display_amount and display_total resolve; composite
; keys compare left to right; a leading '-' reverses only its own key;
; and with -X every amount key is compared in the exchange commodity.
; Pins compare_items<post_t> and compare_items<account_t> in
; src/compare.cc.

2024/01/01 Beta
    Expenses:Food:Bread    $5.00
    Assets:Cash

2024/01/02 Alpha
    Expenses:Food:Fruit    $30.00
    Assets:Cash

2024/01/03 Beta
    Expenses:Rent          $10.00
    Assets:Cash

2024/01/04 Alpha
    Expenses:Travel        $10.00
    Assets:Cash

P 2023/12/01 EUR $2.00

2024/01/05 Alpha
    Travel:Rail            2 EUR
    Assets:Cash

2024/01/06 Beta
    Travel:Air             $12.00
    Assets:Cash

2024/01/07 Alpha
    Travel:Bus             $6.00
    Assets:Cash

test reg Expenses -S -payee,display_amount
24-Jan-01 Beta                  Expenses:Food:Bread           $5.00        $5.00
24-Jan-03 Beta                  Expenses:Rent                $10.00       $15.00
24-Jan-04 Alpha                 Expenses:Travel              $10.00       $25.00
24-Jan-02 Alpha                 Expenses:Food:Fruit          $30.00       $55.00
end test

test reg Expenses -S -display_amount,payee
24-Jan-02 Alpha                 Expenses:Food:Fruit          $30.00       $30.00
24-Jan-04 Alpha                 Expenses:Travel              $10.00       $40.00
24-Jan-03 Beta                  Expenses:Rent                $10.00       $50.00
24-Jan-01 Beta                  Expenses:Food:Bread           $5.00       $55.00
end test

test bal Expenses -S -display_total
              $55.00  Expenses
              $35.00    Food
              $30.00      Fruit
               $5.00      Bread
              $10.00    Rent
              $10.00    Travel
--------------------
              $55.00
end test

test bal Expenses --flat -S display_total,-account
               $5.00  Expenses:Food:Bread
              $10.00  Expenses:Travel
              $10.00  Expenses:Rent
              $30.00  Expenses:Food:Fruit
--------------------
              $55.00
end test

test reg ^Travel -X $ -S payee,amount
24-Jan-05 Alpha                 Travel:Rail                   $4.00        $4.00
24-Jan-07 Alpha                 Travel:Bus                    $6.00       $10.00
24-Jan-06 Beta                  Travel:Air                   $12.00       $22.00
end test

test bal ^Travel --flat -X $ -S -amount,account
              $12.00  Travel:Air
               $6.00  Travel:Bus
               $4.00  Travel:Rail
--------------------
              $22.00
end test
