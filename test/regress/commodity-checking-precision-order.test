; The declared-precision check uses the same commodity checking level as
; the unknown-commodity check: --pedantic makes excess precision an error
; whatever order --strict and --pedantic come in, and --strict-commodity
; alone warns without touching account checking.

commodity USD
    format 1,000.00 USD

account Assets:Portfolio
account Assets:Cash

2024/01/01 Investment Purchase
    Assets:Portfolio    1.12345 USD
    Assets:Cash        -1.12345 USD

test reg --strict-commodity --format "%(amount)\n" Assets:Portfolio
1.12 USD
__ERROR__
Warning: "$FILE", line 13: Amount for commodity 'USD' has 5 decimal places but declared format only shows 2
Warning: "$FILE", line 14: Amount for commodity 'USD' has 5 decimal places but declared format only shows 2
end test

test reg --strict --pedantic --format "%(amount)\n" Assets:Portfolio -> 1
__ERROR__
While parsing file "$FILE", line 13:
While parsing posting:
  Assets:Portfolio    1.12345 USD
                      ^^^^^^^^^^^
Error: Amount for commodity 'USD' has 5 decimal places but declared format only shows 2
end test

test reg --pedantic --strict --format "%(amount)\n" Assets:Portfolio -> 1
__ERROR__
While parsing file "$FILE", line 13:
While parsing posting:
  Assets:Portfolio    1.12345 USD
                      ^^^^^^^^^^^
Error: Amount for commodity 'USD' has 5 decimal places but declared format only shows 2
end test

test reg --strict-commodity --pedantic --format "%(amount)\n" Assets:Portfolio -> 1
__ERROR__
While parsing file "$FILE", line 13:
While parsing posting:
  Assets:Portfolio    1.12345 USD
                      ^^^^^^^^^^^
Error: Amount for commodity 'USD' has 5 decimal places but declared format only shows 2
end test

test reg --permissive --strict --format "%(amount)\n" Assets:Portfolio
1.12 USD
__ERROR__
Warning: "$FILE", line 13: Amount for commodity 'USD' has 5 decimal places but declared format only shows 2
Warning: "$FILE", line 14: Amount for commodity 'USD' has 5 decimal places but declared format only shows 2
end test
