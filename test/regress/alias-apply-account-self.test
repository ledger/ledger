; account_alias_directive rejects an alias whose name equals its target's
; resolved full name (src/textual_directives.cc:701-714, "Illegal alias
; %1%=%2%"); under apply account Top the target Foo is Top:Foo, so the
; alias name Top:Foo collides with it (src/textual_directives.cc,
; instance_t::alias_directive resolving the target with
; top_account()->find_account).

apply account Top
alias Top:Foo=Foo
end apply account
2024/01/01 X
    Foo    $10
    Cash

test bal -> 1
__ERROR__
While parsing file "$FILE", line 9:
Error: Illegal alias Top:Foo=Top:Foo
end test
