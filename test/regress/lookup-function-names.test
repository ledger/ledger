; Every name the report, posting, transaction, item, account and session
; scopes bind in a value expression, called so that the result identifies
; the function behind the name.  The journal gives each function a value
; that no other function of the same table matches on some line below: a
; cleared, a pending and an uncleared transaction, a generated posting, a
; virtual and a balanced virtual posting, a sale whose @ price differs
; from its lot cost, a posting whose Payee tag changes the payee and whose
; comment adds a second line, transactions with and without a UUID, a
; parent account with postings of its own, and a timelog entry.  So a row
; that binds a name to another function of its table changes the output,
; and a missing or misspelled row makes the name fail or fall through to
; another scope, which also changes it.  Names bound to one function
; (b/cost, n/N/count/index, ...) are aliases and are not told apart.  Two
; pairs agree on every input this file can build: rounded and one-argument
; round, and clear_commodity and quantity on an amount.  The sibling file
; lookup-function-name-errors.test separates roundto from round,
; clear_commodity from quantity, and to_balance from the functions that
; return their argument unchanged, and pins the errors of the phase-1
; names.  This file holds no block that expects an error, so its journal
; is replayed against the Lean oracle (test/semantic/check_all.py).
; Report names that a posting or an account shadows (date, value_date,
; commodity, display_account, post, null, d) are reached from eval or from
; an account (balance) context, where nothing nearer answers them.

commodity $
    format $1,000.00

account Expenses:Food
    note food aisle
account Expenses:Food:Fruit
    note produce aisle
    ; Kind: produce

P 2024/03/01 AAPL $120.00

= /Fruit/
    (Budget:Food)                     -1

2024/01/15=2024/01/17 * (1001) Grocer  ; xact note
    ; UUID: 0a1b2c
    Expenses:Food:Fruit           $12.345  ; :organic:
    Expenses:Food                   $2.00
        ; Payee: Bakery
    Assets:Bank:Checking

2024/02/20 ! Broker
    ; UUID: 7f8e9d
    Assets:Brokerage              10 AAPL {$100.00} [2024/02/20]
    Assets:Bank:Checking       $-1,000.00

2024/02/21 Broker
    Assets:Brokerage               5 AAPL {$130.00} [2024/02/21]
    * Assets:Bank:Checking       $-650.00
    [Savings:Goal]                 $50.00
    [Assets:Bank:Checking]        $-50.00

2024/02/22 Broker
    Assets:Brokerage               2 AAPL {$90.00} [2024/02/22]
    Assets:Bank:Checking         $-180.00

2024/03/05 Broker
    Assets:Brokerage              -4 AAPL {$100.00} [2024/02/20] @ $120.00
    Assets:Bank:Checking          $480.00
    Income:Gains                  $-80.00

2024/03/12 Grocer
    Expenses:Food:Fruit             $3.00
    Assets:Bank:Checking

i 2024/03/10 09:00:00 Work:Project
O 2024/03/10 11:30:00

; report: numeric functions on $-2.567
test reg Fruit --head 1 --format 'abs=%(abs($-2.567)) ceiling=%(ceiling($-2.567)) floor=%(floor($-2.567)) round=%(round($-2.567)) round_n=%(round(1.256, 1)) roundto=%(roundto(1.256, 2)) truncate=%(truncate($-2.567) * 1000) truncate_n=%(truncate(-2.567, 3)) to_int=%(to_int($-2.567)) unround=%(unround($-2.567)) unrounded=%(unrounded($-2.567)) U=%(U(-2))\n'
abs=$2.57 ceiling=$-2.00 floor=$-3.00 round=$-2.57 round_n=1.3 roundto=1.26 truncate=$-2,560.00 truncate_n=-2.567 to_int=-3 unround=$-2.567 unrounded=$-2.567 U=2
end test

; report: rounding family on the posting amount; unround is a synonym of unrounded
test reg Fruit --head 1 --format 'rounded=%(rounded(unrounded(amount))) rounded_scaled=%(rounded($-2.567) * 1000) unrounded=%(unrounded(amount)) unround=%(unround(amount)) roundto_commodity=%(roundto_commodity($-2.567) * 1000) clear_commodity=%(clear_commodity(amount)) to_balance=%(to_balance($2.567) * 2)\n'
rounded=$12.35 rounded_scaled=$-2,567.00 unrounded=$12.345 unround=$12.345 roundto_commodity=$-2,570.00 clear_commodity=12.345 to_balance=$5.13
end test

; report: unround is a synonym of unrounded, also for a sequence
test eval 'unround(1.5, 2.5)'
(1.5, 2.5)
end test

; report: rounded keeps every argument; round reads the first one only
test eval 'rounded($1.555, $2.555)'
($1.555, $2.555)
end test

; report: scrub unreduces, strip does not
test reg Project --format 'scrub=%(scrub(amount)) strip=%(strip(amount))\n'
scrub=2.50h strip=9000s
end test

