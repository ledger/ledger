test reg Brokerage -V --now 2030/06/15 --format 'amount_expr=%(amount_expr) total_expr=%(total_expr) display_amount=%(display_amount) display_total=%(display_total) t=%(t) T=%(T)\n'
amount_expr=10 AAPL {$100.00} [2024/02/20] total_expr=10 AAPL {$100.00} [2024/02/20] display_amount=$1,000.00 display_total=$1,000.00 t=$1,000.00 T=$1,000.00
amount_expr=$300.00 total_expr=$1,300.00 display_amount=$300.00 display_total=$1,300.00 t=$300.00 T=$1,300.00
amount_expr=5 AAPL {$130.00} [2024/02/21] total_expr=10 AAPL {$100.00} [2024/02/20]
5 AAPL {$130.00} [2024/02/21] display_amount=$650.00 display_total=$1,950.00 t=$650.00 T=$1,950.00
amount_expr=$-600.00 total_expr=$1,350.00 display_amount=$-600.00 display_total=$1,350.00 t=$-600.00 T=$1,350.00
amount_expr=2 AAPL {$90.00} [2024/02/22] total_expr=2 AAPL {$90.00} [2024/02/22]
10 AAPL {$100.00} [2024/02/20]
5 AAPL {$130.00} [2024/02/21] display_amount=$180.00 display_total=$1,530.00 t=$180.00 T=$1,530.00
amount_expr=$510.00 total_expr=$2,040.00 display_amount=$510.00 display_total=$2,040.00 t=$510.00 T=$2,040.00
amount_expr=-4 AAPL {$100.00} [2024/02/20] total_expr=2 AAPL {$90.00} [2024/02/22]
6 AAPL {$100.00} [2024/02/20]
5 AAPL {$130.00} [2024/02/21] display_amount=$-480.00 display_total=$1,560.00 t=$-480.00 T=$1,560.00
end test

; report: string functions; format() wins over the --format option
test reg Fruit --head 1 --format 'quoted=%(quoted("a\"b  ")) quoted_rfc=%(quoted_rfc("a\"b  ")) join=%(join(note)) trim=[%(trim("a\"b  "))] justify=[%(justify("z", 3, -1, true))] truncated=%(truncated("abcdef", 4)) format=%(format("<%(payee)>")) to_string=%(to_string(5) + "x") to_string_note=[%(to_string(" %(2) " + note))] to_mask=%("xaby" =~ to_mask("a."))\n'
quoted="a\"b  " quoted_rfc="a""b  " join= :organic:\n xact note\n UUID: 0a1b2c trim=[a"b] justify=[  z] truncated=ab.. format=<Grocer> to_string=5x to_string_note=[ %(2)  :organic:
 xact note
 UUID: 0a1b2c] to_mask=true
end test

; report: strip/S, market/P, nail_down, commodity_price
test reg Brokerage --format 'strip=%(strip(amount)) S=%(S(amount)) market=%(market(amount, date, "$")) P=%(P(amount, date, "$")) nail_down=%(market(nail_down(1 AAPL, $5), [2024/03/02], "$")) commodity_price=%(commodity_price(5 AAPL, [2024/03/02]))\n'
strip=10 AAPL S=10 AAPL market=$1,000.00 P=$1,000.00 nail_down=$5.00 commodity_price=$120.00
strip=5 AAPL S=5 AAPL market=$650.00 P=$650.00 nail_down=$5.00 commodity_price=$120.00
strip=2 AAPL S=2 AAPL market=$180.00 P=$180.00 nail_down=$5.00 commodity_price=$120.00
strip=-4 AAPL S=-4 AAPL market=$-480.00 P=$-480.00 nail_down=$5.00 commodity_price=$120.00
end test

