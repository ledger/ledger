test select 'account, amount from posts where virtual'
(Budget:Food)                                                           $-12.35
[Savings:Goal]                                                           $50.00
[Assets:Bank:Checking]                                                  $-50.00
(Budget:Food)                                                            $-3.00
end test

; edge: a sort key compiled against the first posting it sees
test reg -S xact_id Checking --format '%(xact_id) %(amount)\n'
2 $-1,000.00
2 $-650.00
2 $-180.00
2 $480.00
2 $-3.00
3 $-14.35
4 $-50.00
end test
