test reg -M -p "every month from 2023/01/30" Expenses
23-Feb-28 - 23-Mar-29  Expenses:A                         $1           $1
23-Mar-30 - 23-Apr-29  Expenses:A                         $3           $4
23-Apr-30 - 23-May-29  Expenses:A                         $1           $5
end test
