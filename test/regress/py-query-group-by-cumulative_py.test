  2012-02-03 Grocer Assets:Checking $-25.00
  2012-02-15 Electric Company Assets:Checking $-55.00
  2012-02-20 Electric Company Assets:Checking -10 EUR
--group-by account --group-by-cumulative -r -V Expenses: 7 posts, 7 amounts
  2012-02-03 Grocer Expenses:Utilities $5.00
  2012-02-03 Grocer Assets:Checking $-25.00
  2012-01-15 Electric Company Assets:Checking $-50.00
  2012-02-03 Grocer Expenses:Food $20.00
  2012-02-03 Grocer Assets:Checking $-25.00
  2012-02-15 Electric Company Assets:Checking $-55.00
  2012-02-20 Electric Company Assets:Checking -10 EUR
--group-by account --group-by-cumulative -r -S payee: 12 posts, 12 amounts
  2012-01-15 Electric Company Expenses:Utilities $50.00
  2012-02-15 Electric Company Expenses:Utilities $55.00
  2012-02-20 Electric Company Expenses:Utilities 10 EUR
  2012-02-03 Grocer Expenses:Food $20.00
  2012-02-03 Grocer Expenses:Utilities $5.00
  2012-02-03 Grocer Expenses:Utilities $5.00
  2012-02-03 Grocer Assets:Checking $-25.00
