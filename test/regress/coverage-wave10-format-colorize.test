; Coverage for --bold-if: the register format wraps its fields in
; ansify_if(..., bold if should_bold), and --bold-if sets should_bold.

2024/01/01 Payee
    Expenses:Food    $10.00
    Assets:Cash

2024/01/15 Groceries
    Expenses:Food    $25.00
    Assets:Cash

; Neither posting matches amount>100, so no line is bolded.
test reg --bold-if "amount>100" Expenses
24-Jan-01 Payee                 Expenses:Food                $10.00       $10.00
24-Jan-15 Groceries             Expenses:Food                $25.00       $35.00
end test
