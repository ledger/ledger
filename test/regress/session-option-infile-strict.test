; An in-file --strict raises checking; it never lowers what the command
; line asked for, and a command-line --permissive still wins for accounts.

--strict

account Assets:Cash

2024/01/01 Lunch
    Expenses:Food    10 FOO
    Assets:Cash

test bal --pedantic-commodity -> 1
__ERROR__
Warning: "$FILE", line 9: Unknown account 'Expenses:Food'
While parsing file "$FILE", line 9:
While parsing posting:
  Expenses:Food    10 FOO
                   ^^^^^^
Error: Unknown commodity 'FOO'
end test

test bal --pedantic -> 1
__ERROR__
While parsing file "$FILE", line 9:
While parsing posting:
  Expenses:Food    10 FOO

Error: Unknown account 'Expenses:Food'
end test

test bal --permissive
             -10 FOO  Assets:Cash
              10 FOO  Expenses:Food
--------------------
                   0
__ERROR__
Warning: "$FILE", line 9: Unknown commodity 'FOO'
end test
