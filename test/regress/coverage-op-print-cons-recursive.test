; Coverage for op.cc
; print_list exercises the O_CONS printing when there are
; multiple function arguments. With 4 arguments, print_list walks
; through nested O_CONS nodes to print "expr1, expr2, expr3, expr4".
; The error caret marks the failing element wherever it sits in a
; comma or semicolon list.

2024/01/01 Test
    Expenses:Food    $100.00
    Assets:Cash

test reg --format "%(justify(amount / 0, 20, -1, true))\n" -> 1
__ERROR__
While evaluating value expression:
  justify((amount / 0), 20, -1, true)
          ^^^^^^^^^^^^
While calling function 'justify (<#EXPR (amount / {0})>, <#EXPR {20}>, <#EXPR {-1}>, 1)':
While handling posting from "$FILE", line 9:
>     Expenses:Food    $100.00
Error: Divide by zero
end test

test eval '(1/0), 2' -> 1
__ERROR__
While evaluating value expression:
  ((1 / 0), 2)
   ^^^^^^^
Error: Divide by zero
end test

test eval '(1/0), 2, 3' -> 1
__ERROR__
While evaluating value expression:
  ((1 / 0), 2, 3)
   ^^^^^^^
Error: Divide by zero
end test

test eval '1, (1/0), 3' -> 1
__ERROR__
While evaluating value expression:
  (1, (1 / 0), 3)
      ^^^^^^^
Error: Divide by zero
end test

test eval '(1/0); 2; 3' -> 1
__ERROR__
While evaluating value expression:
  ((1 / 0); 2; 3)
   ^^^^^^^
Error: Divide by zero
end test

test eval '2, 3, (1/0)' -> 1
__ERROR__
While evaluating value expression:
  (2, 3, (1 / 0))
         ^^^^^^^
Error: Divide by zero
end test
