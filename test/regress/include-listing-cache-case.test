; A cached listing must stay case-exact (issue #1660): after a.dat has been
; included, which lists the directory, A.dat is still not found, even on a
; filesystem that would open it.

include include-listing-cache/a.dat
include include-listing-cache/A.dat

test bal -> 1
__ERROR__
While parsing file "$FILE", line 6:
Error: File to include was not found: $sourcepath/test/regress/include-listing-cache/A.dat
end test
