; Coverage for amount.cc: rounded() in a format expression runs
; report_t::fn_rounded -> value_t::rounded -> value_t::in_place_round ->
; amount_t::in_place_round (display-only rounding).  A parsed amount has
; no keep_precision flag, so amount_t::in_place_round returns at once, and
; the amount prints at the commodity's display precision either way.

commodity $
    format $1,000.00

2024/01/01 Setup
    Expenses:Food    $10.00
    Assets:Cash

2024/01/02 Precise
    Expenses:Tools    $10.126789
    Assets:Cash

test reg --format="%(rounded(amount))\n"
$10.00
$-10.00
$10.13
$-10.13
end test
