; Coverage test for times.cc handle_every_token paths
; and "N units ago/hence" in determine_when
;
; Each block prints how the period expression resolves as of 2030/06/15:
; the stabilized range, start, finish and duration, and the first
; interval the report would use.

test period "every 2 years" --now 2030/06/15 | sed -n '/^--- After/,/^ 1:/p'
--- After stabilization ---
   start: 30-Jan-01
duration: 2 years

--- Sample dates in range (max. 20) ---
 1: 30-Jan-01 -- 31-Dec-31
end test

test period "every 3 quarters" --now 2030/06/15 | sed -n '/^--- After/,/^ 1:/p'
