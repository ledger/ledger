; --anon copies each posting; the copy carries the written total, whose
; commodity is anonymized like the lot price's.
test print --anon @ABC | sed -E 's/[0-9a-f]{8}/XXXXXXXX/g'
2024/01/02 XXXXXXXX
    XXXXXXXX:XXXXXXXX                   3 A {{B100.00}}
    XXXXXXXX:XXXXXXXX

2024/01/08 XXXXXXXX
    XXXXXXXX:XXXXXXXX                   6 A {{B200.00}}
    XXXXXXXX:XXXXXXXX

2024/01/17 XXXXXXXX
    XXXXXXXX:XXXXXXXX                   -3 A {{B100.00}}
    XXXXXXXX:XXXXXXXX
end test

