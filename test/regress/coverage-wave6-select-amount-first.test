; Coverage tests for select.cc
; Tests: amount as the very first column with thus_far empty
; Covers (the column offset is int(amount_width) alone when thus_far starts empty)
; (thus_far += " + " when not the first column)

2024/01/15 Grocery Store
    Expenses:Food    $50.00
    Assets:Checking

; amount as first and only column - thus_far starts empty,
; so the column offset is int(amount_width) alone
test select amount --columns 80
      $50.00
     $-50.00
end test

; total as first, then amount - exercises thus_far accumulation
test select total, amount --columns 80
      $50.00       $50.00
           0      $-50.00
end test
