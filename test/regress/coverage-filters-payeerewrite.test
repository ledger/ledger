; Coverage test for filters.cc
; Tests payee_rewrite directive which triggers rewrite_posts filter.
; payee_rewrite_mappings iteration
; new payee assignment
; The rewritten transaction is one copy, so its payee is shown once.

payee-rewrite Groceries  Whole Foods Market

2024/01/15 Groceries
    Expenses:Food             $50.00
    Assets:Cash

2024/01/20 Gas Station
    Expenses:Gas              $30.00
    Assets:Cash

test reg
24-Jan-15 Whole Foods Market    Expenses:Food                $50.00       $50.00
                                Assets:Cash                 $-50.00            0
24-Jan-20 Gas Station           Expenses:Gas                 $30.00       $30.00
                                Assets:Cash                 $-30.00            0
end test
