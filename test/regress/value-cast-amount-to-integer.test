; The AMOUNT -> INTEGER cast (int(), to_int(), value_t::to_long()) goes
; through amount_t::to_long(): it rounds to the nearest integer, sends
; ties to the even neighbour, and drops the commodity without an error.
; The cast table in src/value.cc and the casted() doc in src/value.h
; describe exactly this; the tests below pin it.

2024/01/01 Rounding
    Expenses:Food    $1.70
    Assets:Cash

test eval 'int(1.7)'
2
end test

test eval 'int(1.4)'
1
end test

test eval 'int(-1.7)'
-2
end test

test eval 'int(2.5)'
2
end test

test eval 'int(3.5)'
4
end test

test eval 'int(-2.5)'
-2
end test

test eval 'int(-3.5)'
-4
end test

test eval 'int($1.70)'
2
end test

test eval 'to_int(2.5 EUR)'
2
end test

test reg --format '%(int(amount))\n' Expenses
2
end test
