; Coverage test for times.cc determine_when's N-units-ago/hence paths
;
; Each block prints how the period expression resolves as of 2030/06/15:
; the stabilized range, start, finish and duration, and the first
; interval the report would use.

test period "2 years ago" --now 2030/06/15 | sed -n '/^--- After/,/^ 1:/p'
--- After stabilization ---
   range: in year 2028 month Jun day 15
   start: 28-Jun-15
  finish: 28-Jun-16

--- Sample dates in range (max. 20) ---
 1: 28-Jun-15
end test

test period "3 quarters ago" --now 2030/06/15 | sed -n '/^--- After/,/^ 1:/p'
