; --time-round checks its value when the option is given, as every other
; option does, rather than when the journal is read: the error names the
; option.

--time-round 15

i 2024/01/01 09:00:00 Projects:Work
o 2024/01/01 09:07:00

test bal --time-round 0 -> 1
__ERROR__
While parsing option '--time-round'
Error: Invalid value for --time-round: 0; expected a positive number of minutes
end test

test bal --time-round "" -> 1
__ERROR__
While parsing option '--time-round'
Error: No argument provided for --time-round
end test
