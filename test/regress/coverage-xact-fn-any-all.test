; Coverage for xact_t::lookup's any() and all(), which are the posting
; scope's fn_post_any and fn_post_all (post.cc).

2024/01/01 Test1
    Expenses:Food    $10.00
    Assets:Cash

2024/01/02 Test2
    Income:Salary   $-1000.00
    Assets:Cash

test reg --format "%(xact.any(account =~ /Expenses/)) %(xact.all(account =~ /:/)) %(xact.all(amount > 0))\n"
true true false
true true false
false true false
false true false
end test
